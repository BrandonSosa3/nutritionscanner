# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# For local development with `docker compose up`, only the API keys below are
# needed — compose supplies DATABASE_URL and REDIS_URL to the containers. The
# values here are for running the backend directly on the host.

# local | ci | production
ENVIRONMENT=local

# Host-side connection strings. Compose overrides these inside containers.
# Note port 5433/6380 — compose maps the containers off the default ports so
# they don't collide with a Postgres or Redis already running on the host.
DATABASE_URL=postgresql+asyncpg://ns:ns_local_dev@localhost:5433/nutritionscanner
REDIS_URL=redis://localhost:6380/0

# Receipt extraction and item resolution.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# USDA FoodData Central. Free, instant signup.
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Where receipt images are written. Personal financial records — gitignored.
RECEIPT_STORAGE_PATH=data/receipts

# Line items + tax - discounts must equal the printed total within this many
# cents, or the receipt is flagged suspect.
RECONCILIATION_TOLERANCE_CENTS=2

# Application-side spend ceiling for the current calendar month, checked
# against recorded LLM call costs before every API call. This is separate from
# (and stricter than) the limit set in the Anthropic Console. Leave blank to
# disable the guard entirely.
MONTHLY_BUDGET_USD=10.00

# Comma-separated. Add the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
LOG_JSON=false
